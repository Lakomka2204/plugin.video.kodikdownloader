<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="plugin.video.kodikdownloader">
    <category id="general" label="30100">
      <group id="1">
        <setting id="shiki_domain" type="string" label="30101">
          <level>0</level>
          <default>https://shikimori.one</default>
          <constraints><options><option>https://shikimori.one</option><option>https://shikimori.io</option><option>https://shikimori.me</option></options></constraints>
          <control type="list" format="string"><heading>30101</heading></control>
        </setting>
        <setting id="shiki_domain_custom" type="string" label="30102">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30102</heading></control>
        </setting>
        <setting id="title_lang" type="integer" label="30103">
          <level>0</level>
          <default>0</default>
          <constraints><options><option label="30104">0</option><option label="30105">1</option></options></constraints>
          <control type="list" format="string"><heading>30103</heading></control>
        </setting>
        <setting id="page_size" type="integer" label="30106">
          <level>0</level>
          <default>20</default>
          <constraints><minimum>10</minimum><step>5</step><maximum>50</maximum></constraints>
          <control type="slider" format="integer"><popup>false</popup></control>
        </setting>
        <setting id="cache_ttl" type="integer" label="30107">
          <level>0</level>
          <default>30</default>
          <constraints><minimum>0</minimum><step>5</step><maximum>240</maximum></constraints>
          <control type="slider" format="integer"><popup>false</popup></control>
        </setting>
        <setting id="clear_cache" type="action" label="30108">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.kodikdownloader/?action=clear_cache)</data>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="action"><close>false</close></control>
        </setting>
      </group>
    </category>
    <category id="adult" label="30109">
      <group id="1">
        <setting id="show_adult" type="boolean" label="30110">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="adult_pin" type="string" label="30111">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30111</heading></control>
        </setting>
      </group>
    </category>
    <category id="kodik" label="30112">
      <group id="1">
        <setting id="kodik_token" type="string" label="30113">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30113</heading></control>
        </setting>
        <setting id="kodik_base" type="string" label="30114">
          <level>0</level>
          <default>https://kodik-api.com</default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30114</heading></control>
        </setting>
      </group>
    </category>
    <category id="playback" label="30115">
      <group id="1">
        <setting id="default_quality" type="integer" label="30116">
          <level>0</level>
          <default>0</default>
          <constraints><options><option label="30117">0</option><option label="30130">360</option><option label="30131">480</option><option label="30132">720</option><option label="30133">1080</option><option label="30118">9999</option></options></constraints>
